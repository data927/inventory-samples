# Next.js loads this when you run from `web/`.
# Python subprocesses inherit these vars (see src/lib/pythonRunner.ts).
# Copy to web/.env and fill in your key.

PYTHON_BIN=../.venv/bin/python

# NEXT_PUBLIC_BASE_PATH=/inventory_segmentor

ANTHROPIC_API_KEY=
# Or OPENAI_API_KEY= / GEMINI_API_KEY=

ANTHROPIC_MODEL=gpt-4o-mini
SEGMENTER_BATCH_SIZE=10
SEGMENTER_SNIPPET_CHARS=600

SEGMENTER_MAX_RETRIES=60
SEGMENTER_RETRY_BASE_SECONDS=2
SEGMENTER_RETRY_MAX_SECONDS=180

SEGMENTER_SUMMARY_MAX_RETRIES=60
SEGMENTER_SUMMARY_RETRY_BASE_SECONDS=2
SEGMENTER_SUMMARY_RETRY_MAX_SECONDS=180
