# =============================================================================
# Repo root `.env` — used by Python CLI / scripts when run from this directory.
# =============================================================================
#
# The Next.js UI (`web/`) does NOT load this file automatically. When you run
# `npm run dev` or `npm run start` from `web/`, only `web/.env` is loaded.
# Keep secrets in sync: either duplicate keys into `web/.env` or maintain one
# file and copy changes over. See `web/.env.example` for the web template.
#
# =============================================================================

## Required (one of)
# Anthropic Messages API
ANTHROPIC_API_KEY=
# OpenAI Chat Completions — or set LLM_PROVIDER=openai and put your OpenAI key in ANTHROPIC_API_KEY
# OPENAI_API_KEY=
# Google Gemini — key starts with AIza; auto-detected from ANTHROPIC_API_KEY or set explicitly
# GEMINI_API_KEY=

## Optional: anthropic | openai | gemini
## Auto-detected from key prefix if unset: AIza* → Gemini, sk-ant-* → Anthropic, sk-proj-* → OpenAI
# LLM_PROVIDER=

## Gemini model override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

## Optional model overrides (defaults shown; only set the one matching your provider)
# Anthropic
ANTHROPIC_MODEL=claude-sonnet-4-6
# OpenAI — defaults to gpt-4o-mini; NOT inherited by OpenAI provider if unset
# OPENAI_MODEL=gpt-4o-mini

SEGMENTER_BATCH_SIZE=25
SEGMENTER_SNIPPET_CHARS=1200

SEGMENTER_MAX_RETRIES=8
SEGMENTER_RETRY_BASE_SECONDS=0.75
SEGMENTER_RETRY_MAX_SECONDS=90

SEGMENTER_SUMMARY_MAX_RETRIES=8
SEGMENTER_SUMMARY_RETRY_BASE_SECONDS=0.75
SEGMENTER_SUMMARY_RETRY_MAX_SECONDS=90

# Optional: repo archive jobs (server.py)
# GITHUB_TOKEN=
# GITLAB_TOKEN=

# --- Google Drive OAuth (see README “Google Drive”) ---
# Path to OAuth client JSON from Google Cloud Console (Desktop recommended; Web OK if redirect URI is registered)
# GOOGLE_OAUTH_CLIENT_SECRETS=.secrets/google_oauth_client.json
# Written by tools/gdrive_scan.py after first browser login
# GOOGLE_OAUTH_TOKEN_PATH=.secrets/google_drive_token.json
# Web clients: register http://localhost:8080/ in Cloud Console, or set a free port and register that URI
# GOOGLE_OAUTH_LOCAL_PORT=8080
# Set to 0 to avoid opening a new tab during OAuth (URL is printed; paste into any browser tab)
# GOOGLE_OAUTH_OPEN_BROWSER=0

# --- Gmail scan token path (OAuth; separate from Drive token) ---
# GMAIL_TOKEN_PATH=.secrets/gmail_token.json
# Gmail search query applied to every mailbox (empty = all mail)
# GMAIL_QUERY=after:2024/01/01

# --- Google Workspace full scan (Service Account + Domain-Wide Delegation) ---
# Required only for scanning ALL users' My Drives across the organisation.
# Shared-Drive-only scans and single-folder scans still use OAuth above.
# GOOGLE_SERVICE_ACCOUNT_FILE=.secrets/service_account.json
# Super-admin email the service account will impersonate for Admin SDK + Shared Drives
# GOOGLE_ADMIN_EMAIL=admin@yourdomain.com
